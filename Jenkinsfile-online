pipeline {
  agent {
    node {
      label 'maven'
    }
  }
  parameters {
    string(name:'TAG_NAME', defaultValue: '', description:'发布版本号，例如 v1.0.0 (留空则不发布正式版)')
  }
  environment {
    DOCKER_CREDENTIAL_ID = 'dockerhub-id'
    GITHUB_CREDENTIAL_ID = 'github-id'
    KUBECONFIG_CREDENTIAL_ID = 'kubeconfig2'
    REGISTRY = 'docker.io'
    DOCKERHUB_NAMESPACE = 'dleastsun01'
    GITHUB_ACCOUNT = 'dleastsun'
    APP_NAME = 'devops-java-sample'
    SONAR_CREDENTIAL_ID = 'sonar-qube'
  }
  stages {
    stage ('checkout scm') {
      steps {
        sh 'git config --global http.sslVerify false'
        sh 'git config --global --add core.gitProxy ""'
        sh 'git config --global http.postBuffer 524288000'
        checkout(scm)
      }
    }
    stage ('unit test') {
      steps {
        container ('maven') {
          sh 'mvn clean -gs `pwd`/configuration/settings.xml test'
        }
      }
    }

    stage ('build & push') {
      steps {
        container ('maven') {
          sh 'mvn -Dmaven.test.skip=true -gs `pwd`/configuration/settings.xml clean package'
          sh 'docker build --pull=false -f Dockerfile-online -t $REGISTRY/$DOCKERHUB_NAMESPACE/$APP_NAME:SNAPSHOT-$BRANCH_NAME-$BUILD_NUMBER .'
        }
      }
    }
    stage('push latest'){
       when{
         branch 'master'
       }
       steps{
            container ('maven') {

            }
       }
    }
    stage('deploy to dev') {
      when{
        branch 'master'
      }
      steps {
        input(id: 'deploy-to-dev', message: 'deploy to dev?')
        withCredentials([kubeconfigFile(credentialsId: "${KUBECONFIG_CREDENTIAL_ID}", variable: 'KUBECONFIG')]) {
          sh """
            envsubst < deploy/dev-ol/*.yaml | kubectl apply -f -
          """
        }
      }
    }
    stage('push with tag'){
      when{
        expression{
          return params.TAG_NAME =~ /v.*/
        }
      }
      steps {
          container ('maven') {
            input(id: 'release-image-with-tag', message: 'release image with tag?')
            withCredentials([usernamePassword(credentialsId: "$GITHUB_CREDENTIAL_ID", passwordVariable: 'GIT_PASSWORD', usernameVariable: 'GIT_USERNAME')]) {
              sh 'git config --global user.email "kubesphere@yunify.com" '
              sh 'git config --global user.name "kubesphere" '
              sh 'git config --global --add url."https://".insteadOf git://'
              sh 'git tag -a $TAG_NAME -m "$TAG_NAME" '
              sh 'git remote set-url origin http://$GIT_USERNAME:$GIT_PASSWORD@github.com/$GITHUB_ACCOUNT/devops-java-sample.git'
              sh 'git push origin --tags --ipv4'
            }
      }
      }
    }
    stage('deploy to production') {
      when{
        expression{
          return params.TAG_NAME =~ /v.*/
        }
      }
      steps {
        input(id: 'deploy-to-production', message: 'deploy to production?')
        withCredentials([kubeconfigFile(credentialsId: "${KUBECONFIG_CREDENTIAL_ID}", variable: 'KUBECONFIG')]) {
          sh """
            envsubst < deploy/prod-ol/*.yaml | kubectl apply -f -
          """
        }
      }
    }
  }
  post {
    always {
      script {
        if (env.BUILD_NUMBER && env.NODE_NAME) {
          cleanWs()
        }
      }
    }
    failure {
      echo "流水线执行失败，请检查日志！"
    }
  }
}
